  <note>
    <title>Encrypted block</title>
    <content><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE en-note SYSTEM "http://xml.evernote.com/pub/enml2.dtd">
<en-note><div>Secret follows:</div><div><en-crypt cipher="RC2" length="64">RU5DUllQVEVEREFUQQ==</en-crypt></div><div>And normal text after it.</div></en-note>]]></content>
    <created>20230106T000000Z</created>
    <updated>20230106T000000Z</updated>
  </note>
  <note>
    <title>Entities and markdown metacharacters</title>
    <content><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE en-note SYSTEM "http://xml.evernote.com/pub/enml2.dtd">
<en-note><div>Caf&eacute; &amp; bar &mdash; 5 &lt; 10.&nbsp;Price: 50&nbsp;&euro;</div><div># Not a heading</div><div>- not a list item</div><div>1. not an ordered item</div><div>a_b_c, *stars*, [brackets], `ticks`, and a &lt;tag&gt;</div></en-note>]]></content>
    <created>20230107T000000Z</created>
    <updated>20230107T000000Z</updated>
  </note>
